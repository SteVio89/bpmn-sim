<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Defs_Dup">
  <bpmn:process id="Process_SubA">
    <bpmn:startEvent id="Start_1"/>
    <bpmn:callActivity id="Call_A" name="Call A"><bpmn:extensionElements><zeebe:calledElement processId="Process_SubA" propagateAllChildVariables="false"/></bpmn:extensionElements></bpmn:callActivity>
    <bpmn:callActivity id="Call_B" name="Call B" calledElement="Process_SubB"/>
    <bpmn:endEvent id="End_1"/>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Call_A"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Call_A" targetRef="Call_B"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Call_B" targetRef="End_1"/>
  </bpmn:process>
</bpmn:definitions>
