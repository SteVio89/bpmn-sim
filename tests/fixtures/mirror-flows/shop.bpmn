<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Defs_Shop">
  <bpmn:collaboration id="Collab_Shop">
    <bpmn:participant id="Part_Shop" name="Shop" processRef="Process_Shop"/>
    <bpmn:participant id="Part_Supplier" name="Supplier"/>
    <bpmn:messageFlow id="MF_Out" sourceRef="Call_Order" targetRef="Part_Supplier"/>
    <bpmn:messageFlow id="MF_In" sourceRef="Part_Supplier" targetRef="Call_Order"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_Shop">
    <bpmn:startEvent id="Start_Shop"/>
    <bpmn:callActivity id="Call_Order" name="Order goods" calledElement="Process_Order"/>
    <bpmn:endEvent id="End_Shop"/>
    <bpmn:sequenceFlow id="FS1" sourceRef="Start_Shop" targetRef="Call_Order"/>
    <bpmn:sequenceFlow id="FS2" sourceRef="Call_Order" targetRef="End_Shop"/>
  </bpmn:process>
</bpmn:definitions>
