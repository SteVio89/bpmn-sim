<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_EventSub">
  <bpmn:process id="Process_Order" name="Order">
    <bpmn:startEvent id="Start" name="Order received"/>
    <bpmn:task id="Task_Handle" name="Handle order"/>
    <bpmn:endEvent id="End" name="Order handled"/>
    <bpmn:sequenceFlow id="F0" sourceRef="Start" targetRef="Task_Handle"/>
    <bpmn:sequenceFlow id="F1" sourceRef="Task_Handle" targetRef="End"/>
    <bpmn:subProcess id="Sub_Timeout" name="Time out" triggeredByEvent="true">
      <bpmn:startEvent id="Start_Timeout" name="2 days passed"><bpmn:timerEventDefinition/></bpmn:startEvent>
      <bpmn:task id="Task_Cancel" name="Cancel order"/>
      <bpmn:endEvent id="End_Cancelled" name="Order cancelled"/>
      <bpmn:sequenceFlow id="T0" sourceRef="Start_Timeout" targetRef="Task_Cancel"/>
      <bpmn:sequenceFlow id="T1" sourceRef="Task_Cancel" targetRef="End_Cancelled"/>
    </bpmn:subProcess>
    <bpmn:subProcess id="Sub_Reminder" name="Remind" triggeredByEvent="true">
      <bpmn:startEvent id="Start_Reminder" name="1 day passed" isInterrupting="false"><bpmn:timerEventDefinition/></bpmn:startEvent>
      <bpmn:task id="Task_Remind" name="Send reminder"/>
      <bpmn:endEvent id="End_Reminded" name="Reminder sent"/>
      <bpmn:sequenceFlow id="R0" sourceRef="Start_Reminder" targetRef="Task_Remind"/>
      <bpmn:sequenceFlow id="R1" sourceRef="Task_Remind" targetRef="End_Reminded"/>
    </bpmn:subProcess>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Process_Order">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="152" y="102" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Handle_di" bpmnElement="Task_Handle"><dc:Bounds x="240" y="80" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End"><dc:Bounds x="392" y="102" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F0_di" bpmnElement="F0"><di:waypoint x="188" y="120"/><di:waypoint x="240" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="340" y="120"/><di:waypoint x="392" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Sub_Timeout_di" bpmnElement="Sub_Timeout" isExpanded="true"><dc:Bounds x="140" y="220" width="320" height="150"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Timeout_di" bpmnElement="Start_Timeout"><dc:Bounds x="172" y="282" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Cancel_di" bpmnElement="Task_Cancel"><dc:Bounds x="250" y="260" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Cancelled_di" bpmnElement="End_Cancelled"><dc:Bounds x="392" y="282" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="T0_di" bpmnElement="T0"><di:waypoint x="208" y="300"/><di:waypoint x="250" y="300"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="T1_di" bpmnElement="T1"><di:waypoint x="350" y="300"/><di:waypoint x="392" y="300"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Sub_Reminder_di" bpmnElement="Sub_Reminder" isExpanded="true"><dc:Bounds x="500" y="220" width="320" height="150"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Reminder_di" bpmnElement="Start_Reminder"><dc:Bounds x="532" y="282" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Remind_di" bpmnElement="Task_Remind"><dc:Bounds x="610" y="260" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Reminded_di" bpmnElement="End_Reminded"><dc:Bounds x="752" y="282" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="R0_di" bpmnElement="R0"><di:waypoint x="568" y="300"/><di:waypoint x="610" y="300"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="R1_di" bpmnElement="R1"><di:waypoint x="710" y="300"/><di:waypoint x="752" y="300"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
